{
  "name": "dsh-google-scholar",
  "description": "SerpAPI Google Scholar 学术检索插件：search / cited_by / all_versions 三个 LLM 工具（共享月配额）",
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "author": "Zam233",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zam233/dsh-google-scholar.git"
  },
  "homepage": "https://github.com/Zam233/dsh-google-scholar#readme",
  "bugs": {
    "url": "https://github.com/Zam233/dsh-google-scholar/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "google-scholar",
    "serpapi",
    "academic-search",
    "literature"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
